generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DIETICIAN
  CLIENT
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_CONVERTED_TO_CLIENT
  CLIENT_PROFILE_CREATED
  DIETICIAN_PROFILE_CREATED
  CLIENT_ASSIGNED
  CLIENT_UNASSIGNED
  PROFILE_UPDATED
  NOTE_CREATED
  NOTE_UPDATED
  NOTE_DELETED
  QUESTION_THREAD_CREATED
  MESSAGE_SENT
  MESSAGES_MARKED_READ
  CLINICAL_ASSESSMENT_CREATED
  CLINICAL_ASSESSMENT_UPDATED
  CLINICAL_ASSESSMENT_SUBMITTED
  CLINICAL_ASSESSMENT_REVIEWED
  CLINICAL_ASSESSMENT_FINALIZED
  SESSION_REVOKED
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

enum NoteVisibility {
  PRIVATE
  SHARED_WITH_CLIENT
}

enum NoteType {
  GENERAL
  FOLLOW_UP
  CLINICAL
  INTERNAL
}

enum QuestionThreadStatus {
  OPEN
  CLOSED
}

enum ClinicalAssessmentStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  FINALIZED
}

model User {
  id                   String                    @id @default(uuid())
  email                String                    @unique
  passwordHash         String
  role                 UserRole
  status               UserStatus
  firstName            String
  lastName             String
  phone                String?
  lastLoginAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  sessions             Session[]
  auditLogs            AuditLog[]
  clientProfile        ClientProfile?
  dieticianProfile     DieticianProfile?
  clientAssignments    ClientDieticianAssignment[] @relation("ClientAssignments")
  dieticianAssignments ClientDieticianAssignment[] @relation("DieticianAssignments")
  convertedLeads       Lead[]                    @relation("LeadConvertedClient")
  authoredNotes        Note[]                    @relation("NoteAuthor")
  clientNotes          Note[]                    @relation("NoteClient")
  deletedNotes         Note[]                    @relation("NoteDeletedBy")
  clientQuestionThreads QuestionThread[]         @relation("QuestionThreadClient")
  dieticianQuestionThreads QuestionThread[]      @relation("QuestionThreadDietician")
  sentMessages         Message[]
  clientClinicalAssessment ClinicalAssessment?   @relation("ClinicalAssessmentClient")
  createdClinicalAssessments ClinicalAssessment[] @relation("ClinicalAssessmentCreatedBy")
  updatedClinicalAssessments ClinicalAssessment[] @relation("ClinicalAssessmentUpdatedBy")
  reviewedClinicalAssessments ClinicalAssessment[] @relation("ClinicalAssessmentReviewedBy")
  finalizedClinicalAssessments ClinicalAssessment[] @relation("ClinicalAssessmentFinalizedBy")

  @@index([role])
  @@index([status])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Lead {
  id                String     @id @default(uuid())
  fullName          String
  email             String
  phone             String
  interestedService String
  healthGoal        String?
  preferredDate     DateTime?
  preferredTime     String?
  message           String?
  consentAccepted   Boolean
  status            LeadStatus @default(NEW)
  convertedClientId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  convertedClient   User?      @relation("LeadConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ClientProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  dateOfBirth            DateTime?
  gender                 String?
  maritalStatus          String?
  bloodGroup             String?
  isChildAccount         Boolean  @default(false)
  primaryContact         String?
  alternateContact       String?
  profession             String?
  familyMemberOnboarded  Boolean  @default(false)
  address                String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  occupation             String?
  lifestyle              String?
  primaryGoal            String?
  otherGoal              String?
  height                 Decimal?
  weight                 Decimal?
  fatPercentage          Decimal?
  visceralFat            Decimal?
  restingMetabolismKcal  Decimal?
  bodyAge                Decimal?
  fatMassKg              Decimal?
  totalSubcutaneousFatPercentage Decimal?
  subcutaneousFatTrunkPercentage Decimal?
  subcutaneousFatArmsPercentage Decimal?
  subcutaneousFatLegsPercentage Decimal?
  totalSkeletalMusclePercentage Decimal?
  skeletalMuscleTrunkPercentage Decimal?
  skeletalMuscleArmsPercentage Decimal?
  skeletalMuscleLegsPercentage Decimal?
  bmi                    Decimal?
  fatFreeMassKg          Decimal?
  waistInch              Decimal?
  hipInch                Decimal?
  waterContentPercentage Decimal?
  boneWeightKg           Decimal?
  clientMedicalCondition String?
  parentMedicalConditionAndSymptoms String?
  otherMedicalConditions String?
  clientMedicalSymptoms  String?
  activityState          String?
  intensity              String?
  coldFrequency          String?
  bloodPressure          String?
  systolicBp             Decimal?
  diastolicBp            Decimal?
  healthRating           String?
  fitnessRating          String?
  remarks                String?
  allergies              String?
  foodPreferences        String?
  foodRestrictions       String?
  medicalConditions      String?
  medications            String?
  profileCompletionPercent Int    @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DieticianProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  qualification  String?
  specialization String?
  licenseNumber  String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClientDieticianAssignment {
  id           String           @id @default(uuid())
  clientId     String
  dieticianId  String
  status       AssignmentStatus @default(ACTIVE)
  assignedAt   DateTime         @default(now())
  unassignedAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  client       User             @relation("ClientAssignments", fields: [clientId], references: [id], onDelete: Cascade)
  dietician    User             @relation("DieticianAssignments", fields: [dieticianId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([dieticianId])
  @@index([status])
  @@index([assignedAt])
}

model Note {
  id         String         @id @default(uuid())
  clientId   String
  authorId   String
  title      String?
  content    String
  visibility NoteVisibility
  noteType   NoteType
  isDeleted  Boolean        @default(false)
  deletedAt  DateTime?
  deletedById String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  client     User           @relation("NoteClient", fields: [clientId], references: [id], onDelete: Cascade)
  author     User           @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  deletedBy  User?          @relation("NoteDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([authorId])
  @@index([visibility])
  @@index([noteType])
  @@index([isDeleted])
  @@index([createdAt])
}

model QuestionThread {
  id            String               @id @default(uuid())
  clientId      String
  dieticianId   String
  status        QuestionThreadStatus @default(OPEN)
  lastMessageAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  client        User                 @relation("QuestionThreadClient", fields: [clientId], references: [id], onDelete: Cascade)
  dietician     User                 @relation("QuestionThreadDietician", fields: [dieticianId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([clientId, dieticianId])
  @@index([clientId])
  @@index([dieticianId])
  @@index([status])
  @@index([lastMessageAt])
}

model Message {
  id          String         @id @default(uuid())
  threadId    String
  senderId    String
  messageBody String
  isDeleted   Boolean        @default(false)
  deletedAt   DateTime?
  readAt      DateTime?
  createdAt   DateTime       @default(now())
  thread      QuestionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender      User           @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
  @@index([readAt])
  @@index([createdAt])
  @@index([isDeleted])
}

model ClinicalAssessment {
  id                      String                   @id @default(uuid())
  clientId                String                   @unique
  createdById             String?
  updatedById             String?
  reviewedById            String?
  finalizedById           String?
  status                  ClinicalAssessmentStatus @default(DRAFT)
  version                 Int                      @default(1)
  chiefConcern            String?
  currentSymptoms         String?
  currentMedications      String?
  allergies               String?
  medicalHistory          String?
  familyHistory           String?
  digestiveIssues         String?
  sleepPattern            String?
  stressLevel             String?
  activityLevel           String?
  menstrualHistory        String?
  pregnancyOrLactation    String?
  smokingAlcoholHistory   String?
  foodIntolerances        String?
  previousDietHistory     String?
  height                  Decimal?
  weight                  Decimal?
  bmi                     Decimal?
  waistCircumference      Decimal?
  hipCircumference        Decimal?
  bloodPressure           String?
  systolicBp              Int?
  diastolicBp             Int?
  restingHeartRate        Int?
  fastingBloodSugar       Decimal?
  postMealBloodSugar      Decimal?
  hba1c                   Decimal?
  totalCholesterol        Decimal?
  hdl                     Decimal?
  ldl                     Decimal?
  triglycerides           Decimal?
  thyroidTsh              Decimal?
  vitaminD                Decimal?
  vitaminB12              Decimal?
  hemoglobin              Decimal?
  creatinine              Decimal?
  sgpt                    Decimal?
  sgot                    Decimal?
  clinicalObservations    String?
  assessmentSummary       String?
  nutritionDiagnosis      String?
  riskFlags               String?
  dieticianRecommendations String?
  followUpRecommendations String?
  internalRemarks         String?
  submittedAt             DateTime?
  reviewedAt              DateTime?
  finalizedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  client                  User                     @relation("ClinicalAssessmentClient", fields: [clientId], references: [id], onDelete: Cascade)
  createdBy               User?                    @relation("ClinicalAssessmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy               User?                    @relation("ClinicalAssessmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  reviewedBy              User?                    @relation("ClinicalAssessmentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  finalizedBy             User?                    @relation("ClinicalAssessmentFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedAt])
  @@index([reviewedAt])
  @@index([finalizedAt])
  @@index([updatedAt])
}
