generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DIETICIAN
  CLIENT
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_CONVERTED_TO_CLIENT
  CLIENT_PROFILE_CREATED
  DIETICIAN_PROFILE_CREATED
  CLIENT_ASSIGNED
  CLIENT_UNASSIGNED
  PROFILE_UPDATED
  SESSION_REVOKED
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                   String                    @id @default(uuid())
  email                String                    @unique
  passwordHash         String
  role                 UserRole
  status               UserStatus
  firstName            String
  lastName             String
  phone                String?
  lastLoginAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  sessions             Session[]
  auditLogs            AuditLog[]
  clientProfile        ClientProfile?
  dieticianProfile     DieticianProfile?
  clientAssignments    ClientDieticianAssignment[] @relation("ClientAssignments")
  dieticianAssignments ClientDieticianAssignment[] @relation("DieticianAssignments")
  convertedLeads       Lead[]                    @relation("LeadConvertedClient")

  @@index([role])
  @@index([status])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Lead {
  id                String     @id @default(uuid())
  fullName          String
  email             String
  phone             String
  interestedService String
  healthGoal        String?
  preferredDate     DateTime?
  preferredTime     String?
  message           String?
  consentAccepted   Boolean
  status            LeadStatus @default(NEW)
  convertedClientId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  convertedClient   User?      @relation("LeadConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ClientProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  dateOfBirth            DateTime?
  gender                 String?
  maritalStatus          String?
  bloodGroup             String?
  isChildAccount         Boolean  @default(false)
  primaryContact         String?
  alternateContact       String?
  profession             String?
  familyMemberOnboarded  Boolean  @default(false)
  address                String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  occupation             String?
  lifestyle              String?
  primaryGoal            String?
  otherGoal              String?
  height                 Decimal?
  weight                 Decimal?
  fatPercentage          Decimal?
  visceralFat            Decimal?
  restingMetabolismKcal  Decimal?
  bodyAge                Decimal?
  fatMassKg              Decimal?
  totalSubcutaneousFatPercentage Decimal?
  subcutaneousFatTrunkPercentage Decimal?
  subcutaneousFatArmsPercentage Decimal?
  subcutaneousFatLegsPercentage Decimal?
  totalSkeletalMusclePercentage Decimal?
  skeletalMuscleTrunkPercentage Decimal?
  skeletalMuscleArmsPercentage Decimal?
  skeletalMuscleLegsPercentage Decimal?
  bmi                    Decimal?
  fatFreeMassKg          Decimal?
  waistInch              Decimal?
  hipInch                Decimal?
  waterContentPercentage Decimal?
  boneWeightKg           Decimal?
  clientMedicalCondition String?
  parentMedicalConditionAndSymptoms String?
  otherMedicalConditions String?
  clientMedicalSymptoms  String?
  activityState          String?
  intensity              String?
  coldFrequency          String?
  bloodPressure          String?
  systolicBp             Decimal?
  diastolicBp            Decimal?
  healthRating           String?
  fitnessRating          String?
  remarks                String?
  allergies              String?
  foodPreferences        String?
  foodRestrictions       String?
  medicalConditions      String?
  medications            String?
  profileCompletionPercent Int    @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DieticianProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  qualification  String?
  specialization String?
  licenseNumber  String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClientDieticianAssignment {
  id           String           @id @default(uuid())
  clientId     String
  dieticianId  String
  status       AssignmentStatus @default(ACTIVE)
  assignedAt   DateTime         @default(now())
  unassignedAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  client       User             @relation("ClientAssignments", fields: [clientId], references: [id], onDelete: Cascade)
  dietician    User             @relation("DieticianAssignments", fields: [dieticianId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([dieticianId])
  @@index([status])
  @@index([assignedAt])
}
