DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare_dietician_portal?schema=public"
SESSION_COOKIE_NAME="hdp_session"
SESSION_MAX_AGE_DAYS="7"

# Bearer token for POST /api/cron/prune-data, called nightly by an external
# scheduler. Minimum 16 characters; generate with `openssl rand -base64 32`.
CRON_SECRET="generate_a_long_random_string_here"

# One-shot production bootstrap (npm run db:bootstrap).
# Required only the first time an environment is provisioned. Remove both values
# from the environment once the admin has signed in and rotated the password.
INITIAL_ADMIN_EMAIL="admin@yourdomain.com"
INITIAL_ADMIN_PASSWORD="super_secure_password_here"
# Optional display name for the bootstrapped admin.
INITIAL_ADMIN_FIRST_NAME="Platform"
INITIAL_ADMIN_LAST_NAME="Admin"
